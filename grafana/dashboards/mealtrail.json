{"title":"MealTrail operations","uid":"mealtrail-ops","schemaVersion":39,"version":1,"refresh":"15s","time":{"from":"now-6h","to":"now"},"panels":[{"id":1,"title":"Orders by status","type":"timeseries","gridPos":{"h":8,"w":12,"x":0,"y":0},"targets":[{"expr":"sum by (status) (mealtrail_orders_total)","legendFormat":"{{status}}","refId":"A"}]},{"id":2,"title":"HTTP throughput (req/s)","type":"timeseries","gridPos":{"h":8,"w":12,"x":12,"y":0},"targets":[{"expr":"rate(mealtrail_http_requests_total[5m])","legendFormat":"requests/s","refId":"A"}]},{"id":3,"title":"Average simulated delivery (minutes)","type":"timeseries","gridPos":{"h":8,"w":12,"x":0,"y":8},"targets":[{"expr":"mealtrail_delivery_duration_minutes_avg","legendFormat":"minutes","refId":"A"}]},{"id":4,"title":"HTTP error rate","type":"timeseries","gridPos":{"h":8,"w":12,"x":12,"y":8},"targets":[{"expr":"rate(mealtrail_http_errors_total[5m])/clamp_min(rate(mealtrail_http_requests_total[5m]),0.001)","legendFormat":"error fraction","refId":"A"}]}]}
